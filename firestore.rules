rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: read and write allowed
    match /users/{userId} {
      allow read, write: if true;
    }
    // Settings collection: read and write allowed
    match /settings/{docId} {
      allow read, write: if true;
    }
    // Logs collection: read and write allowed
    match /logs/{logId} {
      allow read, write: if true;
    }
    // Support chats collection: read and write allowed
    match /support_chats/{chatId} {
      allow read, write: if true;
    }
  }
}
